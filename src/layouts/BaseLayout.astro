---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import { site, siteOrigin } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Serial fiction, in letters.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
} = Astro.props;

const pageTitle = title === 'Postscripts' ? title : `${title} · ${site.title}`;
const origin = siteOrigin(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, origin).href;
const ogImage = new URL('/og-card.svg', origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15140f" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('postscripts:theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          /* leave default */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <Masthead />
      <main class="site-main" id="content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="site-footer__line">{site.title} · Fiction by correspondence</p>
        <p class="site-footer__line">
          {site.author} · <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="site-footer__line site-footer__links">
          <a href="/#serials">Browse serials</a>
          <span aria-hidden="true">·</span>
          <a href="#content">Back to top</a>
        </p>
      </footer>
    </div>
  </body>
</html>
