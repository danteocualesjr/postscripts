---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../lib/site';
---

<header class="masthead">
  <a class="masthead__link" href="/">
    <h1 class="masthead__title">Postscripts</h1>
    <span class="masthead__flourish" aria-hidden="true">❦</span>
    <p class="masthead__tagline">Serial fiction, in letters</p>
  </a>
  <nav class="masthead__nav" aria-label="Primary navigation">
    <a href="/">Home</a>
    <a href="/#serials">Serials</a>
    <a href={`mailto:${site.email}`}>Contact</a>
  </nav>
  <ThemeToggle />
</header>
