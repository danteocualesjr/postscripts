---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReadingTools from '../../../components/ReadingTools.astro';
import ShareBar from '../../../components/ShareBar.astro';
import {
  getPublishedInstallments,
  getInstallmentSlug,
  getSeriesBySlug,
  formatDate,
  formatDateTimeAttr,
  estimateReadingMinutes,
} from '../../../lib/serials';
import { buildShareText, buildTweetUrl, resolveCanonicalUrl } from '../../../lib/share';
import { siteOrigin } from '../../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const installments = await getPublishedInstallments();

  return Promise.all(
    installments.map(async (entry) => {
      const { Content } = await render(entry);
      return {
        params: {
          slug: entry.data.series,
          installment: getInstallmentSlug(entry),
        },
        props: { entry, Content },
      };
    }),
  );
}

const { slug, installment: installmentSlug } = Astro.params;
const { entry, Content } = Astro.props;

const series = await getSeriesBySlug(slug!);

if (!series) {
  return Astro.redirect('/');
}

const installments = await getPublishedInstallments(slug!);
const index = installments.findIndex((item) => getInstallmentSlug(item) === installmentSlug);
const prev = index > 0 ? installments[index - 1] : undefined;
const next = index >= 0 && index < installments.length - 1 ? installments[index + 1] : undefined;

const canonicalPath = `/serials/${slug}/${installmentSlug}`;
const origin = siteOrigin(Astro.url.origin);
const shareUrl = resolveCanonicalUrl(canonicalPath, Astro.site, origin);
const shareText = buildShareText(entry.data.title, series?.data.title ?? 'Postscripts');
const tweetUrl = buildTweetUrl(shareUrl, shareText);
const shareDescription = series?.data.description ?? 'Serial fiction, in letters.';
const readingMinutes = estimateReadingMinutes(entry.body);
---

<BaseLayout
  title={entry.data.title}
  description={shareDescription}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="reading-progress__bar" data-reading-progress></div>
  </div>

  <article class="reading">
    <a class="reading__back" href={`/serials/${slug}`}>{series?.data.title ?? 'Series'}</a>
    <ReadingTools />

    <p class="reading__kicker">
      <a href={`/serials/${slug}`}>{series?.data.title}</a>
    </p>
    <h1 class="reading__title">{entry.data.title}</h1>
    <p class="reading__meta">
      {series?.data.author && <span class="reading__author">By {series.data.author} · </span>}
      Installment {entry.data.installment} ·{' '}
      <time datetime={formatDateTimeAttr(entry.data.publishedAt)}>
        {formatDate(entry.data.publishedAt)}
      </time>
      {' · '}
      <span class="reading__time">{readingMinutes} min read</span>
    </p>

    {entry.data.dateline && <p class="reading__dateline">{entry.data.dateline}</p>}

    <div class="reading__body">
      <Content />
    </div>

    <p class="reading__endmark" aria-hidden="true">End of installment {entry.data.installment}</p>

    <ShareBar url={shareUrl} title={entry.data.title} text={shareText} tweetUrl={tweetUrl} />

    <nav class="reading__nav" aria-label="Installment navigation">
      {
        prev ? (
          <a class="reading__nav-link" href={`/serials/${slug}/${getInstallmentSlug(prev)}`}>
            <span class="reading__nav-kicker">← Previous</span>
            <span class="reading__nav-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            class="reading__nav-link reading__nav-link--next"
            href={`/serials/${slug}/${getInstallmentSlug(next)}`}
          >
            <span class="reading__nav-kicker">Next →</span>
            <span class="reading__nav-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <script>
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('.reading');
    const progress = bar?.parentElement;
    if (bar && article && progress) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const viewport = window.innerHeight || document.documentElement.clientHeight;
        const total = Math.max(1, rect.height - viewport);
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        const ratio = total > 0 ? scrolled / total : 0;
        bar.style.transform = `scaleX(${ratio})`;
        progress.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }
  </script>
</BaseLayout>
