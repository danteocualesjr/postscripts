---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReadingTools from '../../../components/ReadingTools.astro';
import ShareBar from '../../../components/ShareBar.astro';
import {
  getAllSeries,
  getSeriesBySlug,
  getPublishedInstallments,
  getInstallmentSlug,
  formatDate,
  formatDateTimeAttr,
  estimateReadingMinutes,
} from '../../../lib/serials';
import { buildShareText, buildTweetUrl, resolveCanonicalUrl } from '../../../lib/share';
import { siteOrigin } from '../../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const seriesList = await getAllSeries();
  return seriesList.map((series) => ({
    params: { slug: series.data.slug },
  }));
}

const { slug } = Astro.params;
const series = await getSeriesBySlug(slug!);

if (!series) {
  return Astro.redirect('/');
}

const installments = await getPublishedInstallments(slug!);
const stories = await Promise.all(
  installments.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content, slug: getInstallmentSlug(entry) };
  }),
);

const totalReadingMinutes = stories.reduce(
  (sum, { entry }) => sum + estimateReadingMinutes(entry.body),
  0,
);

const canonicalPath = `/serials/${slug}`;
const origin = siteOrigin(Astro.url.origin);
const shareUrl = resolveCanonicalUrl(canonicalPath, Astro.site, origin);
const shareText = buildShareText(series.data.title, 'Postscripts');
const tweetUrl = buildTweetUrl(shareUrl, shareText);
---

<BaseLayout title={series.data.title} description={series.data.description} canonicalPath={canonicalPath}>
  {
    stories.length > 0 && (
      <div
        class="reading-progress"
        role="progressbar"
        aria-label="Reading progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="reading-progress__bar" data-reading-progress></div>
      </div>
    )
  }

  <article class="reading series-reading">
    <a class="reading__back" href="/">Postscripts</a>
    <ReadingTools />

    <header class="series-hero series-hero--reading">
      <p class="series-hero__kicker">Serial</p>
      <h1 class="series-hero__title">{series.data.title}</h1>
      {series.data.author && <p class="series-hero__author">By {series.data.author}</p>}
      <p class="series-hero__description">{series.data.description}</p>
      {
        stories.length > 0 && (
          <p class="series-hero__meta">
            <time datetime={formatDateTimeAttr(stories[0]!.entry.data.publishedAt)}>
              {formatDate(stories[0]!.entry.data.publishedAt)}
            </time>
            {stories.length > 1 && (
              <>
                {' '}
                –{' '}
                <time datetime={formatDateTimeAttr(stories.at(-1)!.entry.data.publishedAt)}>
                  {formatDate(stories.at(-1)!.entry.data.publishedAt)}
                </time>
              </>
            )}
            {' · '}
            <span class="reading__time">{totalReadingMinutes} min read</span>
          </p>
        )
      }
    </header>

    {
      stories.length > 1 && (
        <nav class="story-jump" aria-label="Installments in this serial">
          <p class="story-jump__label">In this serial</p>
          <ol class="story-jump__list">
            {stories.map(({ entry, slug: storySlug }) => (
              <li>
                <a href={`#${storySlug}`}>
                  <span>{String(entry.data.installment).padStart(2, '0')}</span>
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      stories.length > 0 ? (
        <div class="series-reading__stories">
          {stories.map(({ entry, Content, slug: storySlug }) => (
            <section class="series-story" id={storySlug}>
              <p class="series-story__eyebrow">Installment {entry.data.installment}</p>
              <h2 class="series-story__title">
                <a href={`#${storySlug}`} aria-label={`Link to ${entry.data.title}`}>
                  {entry.data.title}
                </a>
              </h2>
              {entry.data.dateline && <p class="reading__dateline">{entry.data.dateline}</p>}
              <div class="reading__body">
                <Content />
              </div>
            </section>
          ))}
        </div>
      ) : (
        <section class="home-intro">
          <p>No stories published yet. Check back soon.</p>
        </section>
      )
    }

    {
      stories.length > 0 && (
        <ShareBar
          url={shareUrl}
          title={series.data.title}
          text={shareText}
          tweetUrl={tweetUrl}
        />
      )
    }
  </article>

  {
    stories.length > 0 && (
      <script>
        const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
        const article = document.querySelector<HTMLElement>('.series-reading');
        const progress = bar?.parentElement;
        if (bar && article && progress) {
          const update = () => {
            const rect = article.getBoundingClientRect();
            const viewport = window.innerHeight || document.documentElement.clientHeight;
            const total = Math.max(1, rect.height - viewport);
            const scrolled = Math.min(Math.max(-rect.top, 0), total);
            const ratio = total > 0 ? scrolled / total : 0;
            bar.style.transform = `scaleX(${ratio})`;
            progress.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
          };
          update();
          window.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
        }
      </script>
    )
  }
</BaseLayout>
