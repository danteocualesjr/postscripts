---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAllSeries,
  getPublishedInstallments,
  formatSeriesStatus,
} from '../lib/serials';

const seriesList = await getAllSeries();
const installmentsBySeries = Object.fromEntries(
  await Promise.all(
    seriesList.map(async (series) => [
      series.data.slug,
      await getPublishedInstallments(series.data.slug),
    ]),
  ),
);
---

<BaseLayout title="Postscripts">
  <section class="home-intro">
    <p>
      A literary magazine for serial fiction told through letters, notes, and dispatches.
      Choose a series and read from the beginning, or pick up the latest installment.
    </p>
  </section>

  <h2 class="section-label">Serials</h2>

  <ul class="serial-list">
    {
      seriesList.map((series) => {
        const installments = installmentsBySeries[series.data.slug] ?? [];

        return (
          <li class="serial-card">
            <p class="serial-card__status">{formatSeriesStatus(series.data.status)}</p>
            <h3 class="serial-card__title">
              <a href={`/serials/${series.data.slug}`}>{series.data.title}</a>
            </h3>
            <p class="serial-card__description">{series.data.description}</p>
            {
              installments.length === 0 && (
                <p class="serial-card__meta">Coming soon</p>
              )
            }
            {
              installments.length > 0 ? (
                <a class="serial-card__link" href={`/serials/${series.data.slug}`}>
                  Read
                </a>
              ) : (
                <a class="serial-card__link" href={`/serials/${series.data.slug}`}>
                  View series
                </a>
              )
            }
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
